# Copy to .env before running docker compose.

# --- Postgres container ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop
EXT_PORT=8001
PORT=8001

# --- Application DB connection (env wins over config/settings.yml) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_LOGIN=shop
POSTGRES_DATABASE=shop

# --- Migration runner ---
DATABASE_URL=postgresql://shop:shop@postgres:5432/shop

# --- Supplier integration ---
SUPPLIER_A_URL=http://suppliers:8002/A
SUPPLIER_B_URL=http://suppliers:8002/B
SUPPLIER_TIMEOUT_SEC=2.0
SUPPLIER_MAX_RETRIES=2

# --- Background workers (concurrent; job claim via FOR UPDATE SKIP LOCKED) ---
# Сколько воркеров выдачи/восстановления запускать в процессе.
# Несколько воркеров выдачи работают параллельно без двойной выдачи.
# Восстановление идемпотентно, обычно достаточно 1.
DELIVERY_WORKER_COUNT=3
RECOVERY_WORKER_COUNT=1